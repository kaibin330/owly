# ============================================
# Owly - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values
# Required variables are marked with [REQUIRED]
# ============================================

# [REQUIRED] PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/owly?schema=public"

# [REQUIRED] Secret key for JWT token signing (use a random 32+ char string)
JWT_SECRET="change-this-to-a-random-secret"

# [REQUIRED] App URL (used for callbacks and webhooks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Environment (development | production)
NODE_ENV="development"

# ---- AI Provider ----
# OpenAI API key - required for AI-powered responses
OPENAI_API_KEY="sk-your-openai-api-key"

# ---- Phone Channel (Twilio + ElevenLabs) ----
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"
ELEVENLABS_API_KEY="your-elevenlabs-api-key"

# ---- Webhook Security ----
# Secret key for HMAC-SHA256 webhook payload signatures
WEBHOOK_SECRET="change-this-to-a-random-secret"

# ---- CORS (optional) ----
# Set to allow cross-origin API access (e.g., "https://your-frontend.com")
# CORS_ORIGIN=""

# ---- Optional ----
NEXTAUTH_SECRET="change-this-to-a-random-secret"

# ---- ChatbotX escalation bridge (Track B B3 spike, example only) ----
# Default is dry-run: POST /api/integrations/chatbotx/escalate returns JSON
# and does not call the network. "stub" posts only to a loopback URL and
# only for ZZ test names. Do not point this at live 10X or a WhatsApp number.
# Keep the secret server-side. Do not copy it into any NEXT_PUBLIC_ variable.
CHATBOTX_BRIDGE_MODE="dry-run"
CHATBOTX_BRIDGE_URL="http://127.0.0.1:9/chatbotx/escalations"
CHATBOTX_BRIDGE_SECRET="example-only-not-a-real-secret"
CHATBOTX_BRIDGE_KEY_ID="example-chatbotx-bridge"
